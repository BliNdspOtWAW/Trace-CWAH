# Copy to .env.jd (ignored by Git), then fill the key.
PROXY_OPENAI_API_KEY=
JD_API_BASE=https://modelservice.jdcloud.com/v1
JD_MODEL=gpt-5.6-sol
JD_REASONING_EFFORT=high
JD_REQUEST_MAX_RETRIES=20
# Responses output includes reasoning tokens. Independent from visible-output
# limits used by the existing planner/updater; tune after a minimal API probe.
JD_RESPONSES_OUTPUT_BUDGET=8192
