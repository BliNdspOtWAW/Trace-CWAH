# The remote server's 127.0.0.1 is reachable here only through a local SSH tunnel.
QWEN_API_BASE=http://127.0.0.1:18038/v1
# Use the server's actual token if it requires authentication; otherwise a dummy value suffices.
QWEN_API_KEY=unused
QWEN_MODEL=qwen3.8-27b
# Global fallback for any module without an explicit switch.
QWEN_ENABLE_THINKING=0
# Initial comparison: Alice Active only. Other modules retain direct responses.
QWEN_ALICE_ACTIVE_THINKING=1
QWEN_ALICE_UPDATER_THINKING=0
QWEN_ALICE_REACTIVE_THINKING=0
QWEN_BOB_ACTIVE_THINKING=0
QWEN_BOB_REACTIVE_THINKING=0
# Request-scoped bounded thinking; Updater has a smaller budget.
QWEN_REASONING_EFFORT=low
QWEN_THINKING_TOKEN_BUDGET=512
QWEN_UPDATER_THINKING_TOKEN_BUDGET=256
QWEN_UPDATER_MAX_TOKENS=2048
QWEN_CHAT_REQUEST_TIMEOUT=120
QWEN_REQUEST_MAX_RETRIES=2
